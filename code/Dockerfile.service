FROM python:3.11-slim AS builder
ARG APP_MODULE="backend.data_service.app:app"
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libpq-dev && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt ./backend-requirements.txt
COPY ai_models/requirements.txt ai_models/requirements-ml.txt ./ai_models/
RUN pip install --no-cache-dir --prefix=/install -r backend-requirements.txt \
    && case "$APP_MODULE" in ai_models.*) pip install --no-cache-dir --prefix=/install -r ai_models/requirements-ml.txt ;; esac

FROM python:3.11-slim AS runtime
ARG APP_MODULE="backend.data_service.app:app"
ENV APP_MODULE=${APP_MODULE} PYTHONPATH=/app PYTHONUNBUFFERED=1 AI_MODEL_DIR=/app/models
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 curl && rm -rf /var/lib/apt/lists/* \
    && groupadd -r -g 1000 appuser && useradd -r -u 1000 -g appuser -s /sbin/nologin -d /app appuser
WORKDIR /app
COPY --from=builder /install /usr/local
COPY --chown=appuser:appuser . .
RUN mkdir -p /tmp /var/log/quantumalpha /app/models && chown -R appuser:appuser /tmp /var/log/quantumalpha /app/models
USER 1000:1000
EXPOSE 8080 9090
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 CMD curl -f http://localhost:8080/health || exit 1
ENTRYPOINT ["sh", "-c", "case \"$APP_MODULE\" in ai_models.*) W=1; T=960; TH=8;; *) W=4; T=120; TH=1;; esac; exec gunicorn --bind 0.0.0.0:8080 --workers $W --threads $TH --timeout $T \"$APP_MODULE\""]
